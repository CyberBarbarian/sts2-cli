# Copy this file to .env and fill in secrets locally.
# .env is ignored by git.

# OpenAI-compatible LLM endpoint. DeepSeek example:
STS2_BENCH_AGENT=llm
STS2_BENCH_BASE_URL=https://api.deepseek.com/v1
STS2_BENCH_MODEL=deepseek-v4-flash
STS2_BENCH_PROMPT_STYLE=default

DEEPSEEK_API_KEY=

# Small API smoke-test defaults.
STS2_BENCH_CHARACTER=Ironclad
STS2_BENCH_ASCENSION=0
STS2_BENCH_LANG=en
STS2_BENCH_COUNT=1
STS2_BENCH_MAX_STEPS=1
STS2_BENCH_PRINT_PROMPTS=true
STS2_BENCH_PRINT_MODEL_OUTPUT=false
STS2_BENCH_INCLUDE_FULL_MAP=false

# Optional trace output. Leave blank to avoid writing a JSONL file.
STS2_BENCH_OUT=
